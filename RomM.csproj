<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>RomM</RootNamespace>
    <!-- The DLL is RomMnite.dll (extension.yaml's Module); the code's namespace stays RomM. -->
    <AssemblyName>RomMnite</AssemblyName>
    <!-- Keep in sync with extension.yaml; save sync reports it as the client version. -->
    <Version>1.0.0</Version>
    <TargetFramework>net462</TargetFramework>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <ProjectGuid>{2351B5C1-6E28-4B79-A1D9-90FDA53B5417}</ProjectGuid>
  </PropertyGroup>
  <!-- The test project lives under RomM.Tests/ and links source files directly; keep its files
       out of the plugin's default **/*.cs globbing so the plugin build ignores them. -->
  <ItemGroup>
    <Compile Remove="RomM.Tests\**\*.cs" />
    <None Remove="RomM.Tests\**\*" />
  </ItemGroup>
  <!-- The theme the extension is made for, shipped inside it (Setup/ThemeInstaller.cs puts it in
       Playnite's Themes folder). Copied as it is, never compiled. -->
  <ItemGroup>
    <None Remove="Theme\**" />
    <Content Include="Theme\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- SDL2 (zlib licence), 32- and 64-bit, for telling which controllers are connected and
       whether the emulators will know them (Games/ControllerMonitor.cs loads the one that fits). -->
  <ItemGroup>
    <None Remove="Native\**" />
    <Content Include="Native\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>none</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Playnite.SDK, Version=6.18.0.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>..\packages\PlayniteSDK.6.18.0\lib\net462\Playnite.SDK.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <!-- WebRequestHandler: Sunshine's own (self-made) certificate, accepted for this computer only. -->
    <Reference Include="System.Net.Http.WebRequest" />
    <!-- Windows' data protection (ProtectedData), for the saved accounts' passwords. -->
    <Reference Include="System.Security" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Web" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <None Include="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="packages.config" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Localization\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Page Include="Downloads\VersionSelector.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Downloads\RomMDownloadQueueControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="Settings\SettingsView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <PackageReference Include="PlayniteSDK" Version="6.18.0" />
    <PackageReference Include="protobuf-net" Version="2.0.0.668" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SharpCompress" Version="0.36.0" />
    <!-- Windows' own PDF renderer (Windows.Data.Pdf), for showing game manuals in the library. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.28000.2705" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Downloads\RomMDownloadQueueControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="profile.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Downloads\Converters\" />
  </ItemGroup>
  <!-- Every dependency also goes in lib\: Playnite's Toolbox leaves the ones named like Playnite's
       own libraries (SharpCompress, System.Memory...) out of the top folder of the .pext, but not
       out of lib\, where the plugin loads them from (PluginDependencies.cs). -->
  <Target Name="CopyDependenciesToLib" AfterTargets="Build">
    <ItemGroup>
      <!-- Never Playnite's own (Playnite.SDK.dll...): Playnite refuses a package holding them, in any folder. -->
      <RomMLibDependency Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' And !$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').ToLowerInvariant().StartsWith('playnite'))" />
    </ItemGroup>
    <!-- lib\ made afresh each build, so nothing left from an earlier one is packed. -->
    <RemoveDir Directories="$(OutDir)lib" />
    <Copy SourceFiles="@(RomMLibDependency)" DestinationFolder="$(OutDir)lib" />
    <!-- And Playnite's own, whatever the filter above let through: Playnite refuses the package. -->
    <ItemGroup>
      <RomMLibPlaynite Include="$(OutDir)lib\Playnite*.dll" />
    </ItemGroup>
    <Delete Files="@(RomMLibPlaynite)" />
  </Target>
</Project>