<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type Library}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Library}">
                    <Grid d:DesignWidth="1500" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <FadeImage x:Name="PART_ImageBackground" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" >

                            <!--<FadeImage.ImageOpacityMask>
                                <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1" RadiusY="1.5">
                                    <RadialGradientBrush.GradientStops>
                                        <GradientStop Color="Black" Offset="0.4" />
                                        <GradientStop Color="Transparent" Offset="0.98" />
                                    </RadialGradientBrush.GradientStops>
                                </RadialGradientBrush>
                            </FadeImage.ImageOpacityMask>-->
                        </FadeImage>
                 
                        <!-- The game list and page; hidden while the Downloads page is up, as Steam's. -->
                 
                        <Grid Grid.RowSpan="2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{PluginSettings Plugin=RomM, Path=LibraryDownloadsVisible, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <LibraryDetailsView x:Name="PART_ViewDetails" />
                            <LibraryGridView x:Name="PART_ViewGrid" />
                            <LibraryListView x:Name="PART_ViewList" />
                        </Grid>

                        <!-- The library's Home page (shelves of covers), drawn over the game's page
                             while the Home button is on. The first column only reserves the width
                             of the game list, which stays usable beside it. -->
                        <Grid Grid.RowSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Settings DetailsListWitdh}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The Downloads page takes the whole width, the game list's column too. -->
                            <ContentControl x:Name="RomM_LibraryHome">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=RomM, Path=LibraryDownloadsVisible, FallbackValue=False}" Value="True">
                                                <Setter Property="Grid.Column" Value="0" />
                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </Grid>

                        <!-- The library's controls, Steam-style, at the top left above the game list:
                             the Home button, the explorer's two drop-downs, then the search box
                             with the filter button beside it. Stacked in the details view, side by side in the
                             grid and list views. -->
                        <StackPanel Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Orientation" Value="Horizontal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PART_ViewDetails}" Value="Visible">
                                            <Setter Property="Orientation" Value="Vertical" />
                                        </DataTrigger>
                                        <!-- Not over the Downloads page, which is full width. -->
                                        <DataTrigger Binding="{PluginSettings Plugin=RomM, Path=LibraryDownloadsVisible, FallbackValue=False}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ContentControl x:Name="RomM_HomeButton" HorizontalAlignment="Left"
                                            HorizontalContentAlignment="Stretch"
                                            Width="{Settings DetailsListWitdh}" />
                            <ExplorerPanel HorizontalAlignment="Left" Width="{Settings DetailsListWitdh}" Visibility="{Settings ExplorerPanelVisible}" />
                            <!-- The search strip, with RomM's Library Filters button at its right end. -->
                            <Grid HorizontalAlignment="Left" Width="{Settings DetailsListWitdh}">
                                <TopPanel Background="Transparent" Margin="0,0,46,0" />
                                <ContentControl x:Name="RomM_LibraryFilters" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,10,0" />
                            </Grid>
                        </StackPanel>

                        <!-- The filters, as a panel that pops out beside the column (it used to
                             slide in as a full-height side bar). The first column only reserves
                             the width of the game list so the panel opens to the right of it. -->
                        <Grid Grid.RowSpan="2" Panel.ZIndex="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Settings DetailsListWitdh}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FilterPanel x:Name="PART_FilterPanel" Grid.Column="1"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="8,88,0,0"
                                         Visibility="{Settings FilterPanelVisible}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>