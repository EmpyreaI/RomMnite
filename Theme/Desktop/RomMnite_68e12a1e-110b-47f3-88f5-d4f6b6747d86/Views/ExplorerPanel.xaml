<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <!-- A strip of two drop-downs: what to browse by (Platform, Genre, ...) and
                         which of its values to show. Was a full-height panel with a list. -->
                    <Border Height="44" Background="{TemplateBinding Background}"
                            d:DesignWidth="300" d:DesignHeight="44">
                        <!-- Only the values drop-down, the width of the list; the field drop-down (Platform,
                             Genre, Age Rating...) is kept for Playnite but hidden, so the list stays
                             browsed by the field last chosen (Platform). -->
                        <Grid VerticalAlignment="Center" Margin="12,0,12,0">
                            <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto" Visibility="Collapsed"
                                      Style="{StaticResource FreeComboBox}"/>
                            <ComboBox Name="PART_SelectItems" MaxDropDownHeight="420" HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource FreeComboBox}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>